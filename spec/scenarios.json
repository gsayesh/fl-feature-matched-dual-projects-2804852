        {
          "method": "POST",
          "path": "/expenses",
          "form": {
            "date": "2026-11-24",
            "description": "Bread",
            "category": "groceries",
            "amount": "0.4",
            "notes": ""
          },
          "expect": {
            "status": 303,
            "location": "/expenses?notice=added"
          }
        },
        {
          "method": "GET",
          "path": "/expenses?month=2026-11",
          "expect": {
            "status": 200,
            "in_order": [
              "id=\"expense-37\"",
              "id=\"expense-38\"",
              "id=\"expense-36\""
            ]
          }
        }
      ]
    },
