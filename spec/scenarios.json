    {
      "id": "S10",
      "fr": [
        "FR-09",
        "FR-06",
        "FR-08"
      ],
      "title": "Add an expense: 303 redirect, notice, trimmed text, new id",
      "steps": [
        {
          "method": "GET",
          "path": "/expenses/new",
          "expect": {
            "status": 200,
            "contains": [
              "<title>Add expense · Expense Ledger</title>",
              "name=\"date\" type=\"text\" inputmode=\"numeric\" autocomplete=\"off\" placeholder=\"YYYY-MM-DD\" value=\"2026-11-25\"",
