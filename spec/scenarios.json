            "absent": [
              "<ul class=\"latest\">"
            ]
          }
        }
      ]
    },
    {
      "id": "S04",
      "fr": [
        "FR-03"
      ],
      "title": "Spending by category: largest first, shares to one decimal",
      "steps": [
        {
          "method": "GET",
          "path": "/",
          "expect": {
            "status": 200,
            "in_order": [
