              "<li class=\"cat-row cat-utilities\">",
              "<li class=\"cat-row cat-transport\">",
              "<li class=\"cat-row cat-other\">",
              "<li class=\"cat-row cat-leisure\">",
              "<li class=\"cat-row cat-health\">",
              "<li class=\"cat-row cat-dining\">",
              "<span class=\"cat-share\">1.0%</span>"
