    {
      "id": "S08",
      "fr": [
        "FR-07"
      ],
      "title": "Filter by month and category, search text, bookmarkable URLs",
      "steps": [
        {
          "method": "GET",
          "path": "/expenses?month=2026-11&category=utilities",
          "expect": {
            "status": 200,
            "contains": [
              "<p><strong>3 expenses</strong> · OMR 45.450</p>",
