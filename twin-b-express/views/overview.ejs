<%- include('_top') -%>
<%_ /* FR-02: headline figures for one month, with month navigation */ _%>
      <header class="page-head">
        <div>
          <p class="eyebrow">Overview</p>
          <h1><%= month_label %></h1>
        </div>
        <div class="head-actions">
          <nav class="month-switch" aria-label="Month">
            <a href="<%= prev_href %>" aria-label="Previous month: <%= prev_label %>"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 3.5 5.5 8l4.5 4.5"/></svg></a>
            <span><%= month_label %></span>
            <a href="<%= next_href %>" aria-label="Next month: <%= next_label %>"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 3.5 4.5 4.5L6 12.5"/></svg></a>
          </nav>
          <a class="btn btn-primary" href="<%= add_href %>"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M8 3v10M3 8h10"/></svg>Add expense</a>
        </div>
      </header>
      <section class="kpis" aria-label="Headline figures">
        <div class="card kpi kpi-total">
          <p class="kpi-label">Total spent</p>
          <p class="kpi-value"><small>OMR</small><%= total %></p>
          <p class="kpi-sub"><span class="delta<%= delta_cls %>"><%= delta_text %></span></p>
        </div>
        <div class="card kpi">
          <p class="kpi-label">Expenses</p>
          <p class="kpi-value"><%= count %></p>
          <p class="kpi-sub"><%= count_sub %></p>
        </div>
        <div class="card kpi">
          <p class="kpi-label">Daily average</p>
          <p class="kpi-value"><small>OMR</small><%= average %></p>
          <p class="kpi-sub"><%= average_sub %></p>
        </div>
        <div class="card kpi">
          <p class="kpi-label">Largest expense</p>
          <p class="kpi-value"><small>OMR</small><%= largest %></p>
          <p class="kpi-sub"><%= largest_sub %></p>
        </div>
      </section>
      <div class="grid-2">
        <%_ /* FR-04: running total through the month, previous month dashed */ _%>
        <section class="card chart-card">
          <div class="card-head">
            <h2>Spending through the month</h2>
            <div class="legend"><span><i></i><%= chart.cur_label %></span><span><i class="is-prev"></i><%= chart.prev_label %></span></div>
          </div>
          <div class="chart">
            <div class="y-axis" aria-hidden="true">
              <%_ for (const g of chart.grid) { _%>
              <span class="y-label" style="top: <%= g.top %>"><%= g.label %></span>
              <%_ } _%>
            </div>
            <svg viewBox="0 0 <%= chart.w %> <%= chart.h %>" preserveAspectRatio="none" role="img" aria-label="<%= chart.aria %>">
              <defs><linearGradient id="areaFill" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#0d6b53" stop-opacity="0.16"/><stop offset="1" stop-color="#0d6b53" stop-opacity="0"/></linearGradient></defs>
              <%_ for (const g of chart.grid) { _%>
              <line class="grid-line" x1="0" y1="<%= g.y %>" x2="<%= chart.w %>" y2="<%= g.y %>"/>
              <%_ } _%>
              <line class="base-line" x1="0" y1="<%= chart.h %>" x2="<%= chart.w %>" y2="<%= chart.h %>"/>
              <path class="prev" d="<%= chart.prev %>"/>
              <path class="area" d="<%= chart.area %>"/>
              <path class="line" d="<%= chart.line %>"/>
              <%_ for (const h of chart.hits) { _%>
              <rect class="hit" x="<%= h.x %>" y="0" width="<%= h.w %>" height="<%= chart.h %>"><title><%= h.title %></title></rect>
              <%_ } _%>
            </svg>
            <%_ for (const t of chart.ticks) { _%>
            <span class="x-label" style="left: <%= t.left %>"><%= t.label %></span>
            <%_ } _%>
          </div>
        </section>
        <%_ /* FR-03: spending by category, largest first */ _%>
        <section class="card card-pad">
          <div class="card-head">
            <h2>By category</h2>
            <p>Share of <%= month_name %></p>
          </div>
          <%_ if (cats.length > 0) { _%>
          <div class="cat-strip" aria-hidden="true">
            <%_ for (const s of strip) { _%>
            <span class="cat-<%= s.key %>" style="flex-grow: <%= s.grow %>" title="<%= s.title %>"></span>
            <%_ } _%>
          </div>
          <ul class="cat-list">
            <%_ for (const c of cats) { _%>
            <li class="cat-row cat-<%= c.key %>">
              <span class="cat-name"><i class="dot"></i><%= c.label %></span>
              <span class="cat-bar"><span class="cat-<%= c.key %>" style="width: <%= c.share %>"></span></span>
              <span class="cat-amt"><%= c.amount %></span>
              <span class="cat-share"><%= c.share %></span>
            </li>
            <%_ } _%>
          </ul>
          <%_ } else { _%>
          <p class="muted-note">No spending in <%= month_label %>.</p>
          <%_ } _%>
        </section>
      </div>
      <%_ /* FR-05: the five most recent expenses of the month */ _%>
      <section class="card card-pad">
        <div class="card-head">
          <h2>Latest expenses</h2>
          <%_ if (has_data) { _%>
          <a href="<%= latest_href %>">View all in <%= month_name %></a>
          <%_ } _%>
        </div>
        <%_ if (has_data) { _%>
        <ul class="latest">
          <%_ for (const r of latest) { _%>
          <li>
            <span class="when"><%= r.date %></span>
            <span class="what"><strong><%= r.description %></strong><span class="cat-<%= r.key %>"><i class="dot"></i><%= r.label %></span></span>
            <span class="amt"><%= r.amount %></span>
          </li>
          <%_ } _%>
        </ul>
        <%_ } else { _%>
        <div class="empty empty-inline">
          <h2>No expenses in <%= month_label %>.</h2>
          <p>Add the first expense of the month and it will show up here.</p>
          <a class="btn btn-primary" href="<%= add_href %>">Add expense</a>
        </div>
        <%_ } _%>
      </section>
<%- include('_bottom') -%>
