              "<span class=\"y-label\" style=\"top: 0.0%\">600</span>",
              "<title>1 Nov 2026 · OMR 280.000 · running total OMR 280.000</title>",
              "<title>25 Nov 2026 · OMR 0.000 · running total OMR 496.850</title>",
              "<span class=\"x-label\" style=\"left: 1.7%\">1 Nov</span>"
            ],
            "absent": [
              "<title>26 Nov 2026"
            ]
          }
        }
      ]
    },
