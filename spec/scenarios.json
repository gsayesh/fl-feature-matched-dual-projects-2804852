{
  "about": "Shared conformance fixture for both twins. Every scenario starts from a fresh copy of seed.json with today pinned to 2026-11-25. Twin A runs it in tests/test_scenarios.py, Twin B in test/scenarios.test.js. Source of truth: spec/scenarios.json (copied into each twin by tools/sync_shared.py).",
  "today": "2026-11-25",
  "expect_keys": {
    "status": "HTTP status",
    "location": "Location header (redirects)",
    "content_type": "Content-Type header",
    "disposition": "Content-Disposition header",
    "contains": "each text must appear in the body",
    "absent": "none of these may appear",
    "in_order": "each text must appear, in this order",
    "body": "the body must equal this text exactly",
    "empty_body": "the body must be empty"
  },
  "scenarios": [
    {
      "id": "S01",
      "fr": [
        "FR-01",
        "FR-02"
      ],
      "title": "Overview opens on the latest month with the four headline figures",
      "steps": [
        {
          "method": "GET",
          "path": "/",
          "expect": {
            "status": 200,
            "content_type": "text/html; charset=utf-8",
            "contains": [
              "<title>Overview · Expense Ledger</title>",
              "<a class=\"nav-link is-active\" href=\"/\" aria-current=\"page\">",
              "<a class=\"nav-link\" href=\"/expenses\">",
              "<h1>November 2026</h1>",
              "<p class=\"kpi-value\"><small>OMR</small>496.850</p>",
              "<span class=\"delta is-down\">↓ 6.5% vs October</span>",
              "<p class=\"kpi-value\">13</p>",
              "across 8 categories",
              "<p class=\"kpi-value\"><small>OMR</small>19.874</p>",
              "per day over 25 days so far",
              "<p class=\"kpi-value\"><small>OMR</small>280.000</p>",
              "Monthly rent · 1 Nov",
              "<a href=\"/?month=2026-10\" aria-label=\"Previous month: October 2026\">",
              "<a href=\"/?month=2026-12\" aria-label=\"Next month: December 2026\">",
              "<footer class=\"foot\">Expense Ledger 1.0.0 · Amounts in Omani rial (OMR)</footer>"
            ]
          }
        }
      ]
    },
    {
      "id": "S02",
      "fr": [
        "FR-02"
      ],
      "title": "A past month: change against the month before and a full-month daily average",
      "steps": [
        {
          "method": "GET",
          "path": "/?month=2026-10",
          "expect": {
            "status": 200,
            "contains": [
              "<h1>October 2026</h1>",
              "<small>OMR</small>531.550",
              "<span class=\"delta is-up\">↑ 3.7% vs September</span>",
              "<small>OMR</small>17.147",
              "per day over 31 days</p>",
              "<p class=\"kpi-value\">11</p>"
            ]
          }
        },
        {
          "method": "GET",
          "path": "/?month=2026-09",
          "expect": {
            "status": 200,
            "contains": [
              "<h1>September 2026</h1>",
              "<span class=\"delta is-flat\">No spending in August</span>"
            ]
          }
        },
        {
          "method": "GET",
          "path": "/?month=2026-13",
          "expect": {
            "status": 200,
            "contains": [
              "<h1>November 2026</h1>"
            ]
          }
        }
      ]
    },
    {
      "id": "S03",
      "fr": [
        "FR-02",
        "FR-05"
      ],
      "title": "A month without expenses shows zeros and an Add expense button",
      "steps": [
        {
          "method": "GET",
          "path": "/?month=2026-08",
          "expect": {
            "status": 200,
            "contains": [
              "<h1>August 2026</h1>",
              "<small>OMR</small>0.000",
